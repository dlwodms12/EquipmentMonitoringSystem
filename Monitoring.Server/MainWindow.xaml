<Window x:Class="Monitoring.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="장비 모니터링 서버"
        Height="600"
        Width="1000">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="서버 작동 중"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="Green"/>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="장비 목록" Margin="0,0,10,0">
                <ListBox x:Name="DeviceListBox"
                         SelectionChanged="DeviceListBox_SelectionChanged">
                    <ListBoxItem Content="Device-001"/>
                    <ListBoxItem Content="Device-002"/>
                    <ListBoxItem Content="Device-003"/>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="장비 상태">
                    <StackPanel Margin="15">
                        <TextBlock x:Name="SelectedDeviceText"
                                   Text="현재 선택된 장비: 없음"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="상태: -"/>
                        <TextBlock x:Name="TemperatureText" Text="온도: -"/>
                        <TextBlock x:Name="VoltageText" Text="전압: -"/>
                        <TextBlock x:Name="BatteryText" Text="배터리: -"/>
                        <TextBlock x:Name="ConnectionText" Text="통신: -"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="명령 전송" Margin="0,10,0,0">
                    <StackPanel Margin="15">
                        <RadioButton x:Name="PingRadioButton"
                                     Content="Ping"
                                     GroupName="Command"/>
                        <RadioButton x:Name="SystemInfoRadioButton"
                                     Content="Show System"
                                     GroupName="Command"/>
                        <Button Content="Send"
                                Margin="0,10,0,0"
                                Click="SendButton_Click"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Column="2" Header="통신 로그">
                <ListBox x:Name="LogListBox"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
