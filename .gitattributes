# 텍스트 파일의 줄바꿈을 Git에서 일관되게 관리
* text=auto eol=lf

# Windows/Visual Studio에서 주로 다루는 파일
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.cs     text eol=crlf
*.xaml   text eol=crlf
*.config text eol=crlf

# 바이너리 파일
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary